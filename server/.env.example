# Copy to `.env` and fill in real values before deploying.
# ASP.NET Core doesn't auto-load .env files — export these as real
# environment variables (or wire them in via your host/Docker env_file),
# using the standard ASP.NET Core "__" separator for nested config keys.

ASPNETCORE_ENVIRONMENT=Production

MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=portfolio_db

Jwt__Secret=replace-with-a-long-random-secret
Jwt__Issuer=PortfolioApi
Jwt__Audience=PortfolioApiClient
Jwt__ExpiryMinutes=120
